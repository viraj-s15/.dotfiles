// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "project_panel": {
    "dock": "left"
  },
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "git_panel": {
    "dock": "left"
  },
  "buffer_line_height": "comfortable",
  "agent_servers": {
    "opencode": {
      "type": "registry"
    },
    "github-copilot": {
      "type": "registry"
    }
  },
  "show_edit_predictions": false,
  "ui_font_weight": 700.0,
  "vim_mode": true,
  "buffer_font_weight": 400.0,
  "edit_predictions": {
    "provider": "copilot",
    "copilot": {
      "enable_next_edit_suggestions": false
    },
    "mode": "eager"
  },
  "language_models": {
    "openai_compatible": {
      
    }
  },
  "context_servers": {
    "searxng": {
      "enabled": true,
      "command": "npx",
      "args": ["-y", "mcp-searxng"],
      "env": {
        "SEARXNG_URL": "http://0.0.0.0:8080"
      }
    },
    "interactive-feedback-mcp": {
      "timeout": 100000000,
      "env": {},
      "enabled": true,
      "command": "uv",
      "args": [
        "--directory",
        "/home/veer/Documents/interactive-feedback-mcp",
        "run",
        "server.py"
      ]
    }
  },
  "agent": {
    "dock": "right",
    "tool_permissions": {
      "default": "allow"
    },
    "message_editor_min_lines": 2,
    "play_sound_when_agent_done": "never",
    "default_profile": "write",
    "inline_assistant_model": {
      "provider": "copilot_chat",
      "model": "gpt-4.1"
    },
    "profiles": {
      "planning": {
        "name": "Planning",
        "tools": {
          "create_directory": true,
          "delete_path": true,
          "edit_file": true,
          "diagnostics": true,
          "fetch": true,
          "find_path": true,
          "grep": true,
          "move_path": true,
          "list_directory": true,
          "open": true,
          "now": true,
          "project_notifications": true,
          "read_file": true,
          "terminal": true,
          "thinking": true,
          "copy_path": true
        },
        "enable_all_context_servers": false,
        "context_servers": {
          "mcp-server-context7": {
            "tools": {
              "resolve-library-id": true,
              "get-library-docs": true
            }
          },
          "mcp-sequentialthinking-tools": {
            "tools": {
              "sequentialthinking_tools": true
            }
          },
          "interactive-feedback-mcp": {
            "tools": {
              "interactive_feedback": true
            }
          }
        }
      }
    },
    "default_model": {
      "effort": "high",
      "provider": "copilot_chat",
      "model": "gpt-5-mini"
    }
  },
  "ui_font_size": 18.0,
  "buffer_font_size": 20.0,
  "ui_font_family": "JetBrains Mono",
  "buffer_font_family": "JetBrainsMono Nerd Font",
  "theme": {
    "mode": "dark",
    "light": "Catppuccin Mocha (Blur) [Heavy]",
    "dark": "Flat Gray"
  }
}
