[global]
separator_color= frame
follow = mouse
origin = top-right
offset = 10x48
indicate_hidden = yes
separator_color = frame
sort = yes
font = JetBrains Mono 10
markup = full
format = %s\n%b
alignment = left
vertical_alignment = center
ellipsize = middle
ignore_newline = no
show_indicators = yes
icon_position = left
sticky_history = yes
browser = /usr/bin/xdg-open
mouse_left_click = close_current
mouse_middle_click = do_action, close_current
mouse_right_click = close_all
title = Dunst
class = Dunstalways_run_script = true
corner_radius = 0
enable_recursive_icon_lookup = true
frame_color = "#89b4fa"
frame_width = 4
gap_size = 0
height = 80
hide_duplicate_count = false
highlight = "#89b4fa"
history_length = 20
horizontal_padding = 15
idle_threshold = 120
line_height = 2
max_icon_size = 48
min_icon_size = 24
monitor = 0
notification_limit = 0
padding = 15
progress_bar = true
progress_bar_frame_width = 4
progress_bar_height = 80
progress_bar_max_width = 300
progress_bar_min_width = 300
scale = 0
separator_height = 2
show_age_threshold = 60
stack_duplicates = true
text_icon_padding = 0
transparency = 0
width = 300

[urgency_low]
background = "#1e1e2e"
foreground = "#cdd6f4"

[urgency_normal]
background = "#1e1e2e"
foreground = "#cdd6f4"

[urgency_critical]
background = "#1e1e2e"
foreground = "#cdd6f4"
frame_color = "#fab387"
